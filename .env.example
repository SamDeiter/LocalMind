# LocalMind Environment Configuration
# Copy this file to .env and fill in your values.

# ── Workspace Paths (Optional — sensible defaults shown) ──────────
# WORKSPACE_DIR=C:/Users/YourName/LocalMind_Workspace
# DB_PATH=C:/Users/YourName/LocalMind_Workspace/localmind.db

# ── Local Infrastructure ──────────────────────────────────────────
# The fallback is http://127.0.0.1:11434 if not set.
OLLAMA_URL=http://127.0.0.1:11434
# PORT=8000

# ── Model Tiers (Optional — override default models per tier) ─────
# Defaults (April 2026): light=gemma4:e4b, medium=qwen2.5-coder:14b, heavy=qwen2.5-coder:32b
# MODEL_LIGHT=gemma4:e4b
# MODEL_MEDIUM=qwen2.5-coder:14b
# MODEL_HEAVY=qwen2.5-coder:32b
# MODEL_ULTRA=qwen2.5-coder:70b

# ── GPU Config ────────────────────────────────────────────────────
# GPU_VRAM_GB=10

# ── Context Windows ──────────────────────────────────────────────
# MAX_CONTEXT_TOKENS=8192
# DEFAULT_CONTEXT_WINDOW=8192
# MAX_AGENT_ITERATIONS=5

# ── Cloud Model Routing (Optional) ───────────────────────────────
# Get a free API key at https://aistudio.google.com/apikey
# When set, LocalMind can route complex tasks to Gemini (with your approval).
# Without this key, all tasks stay fully local on Ollama.
GEMINI_API_KEY=

# ── Slack Integration ────────────────────────────────────────────
# Create a Slack app with Socket Mode enabled.
# See https://api.slack.com/apis/connections/socket
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_ALLOWED_TEAM_IDS=T12345678
# SLACK_ALLOWED_USER_IDS=U12345678

# ── Google OAuth (Optional — enables Google Workspace tools) ─────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Download the JSON and place at ~/.localmind/credentials.json
# Or set these env vars directly:
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# ── Inference (Advanced) ─────────────────────────────────────────
# Best-of-N sampling generates multiple candidates and picks the best.
BEST_OF_N_ENABLED=false
# DEFAULT_BEST_OF_N=4
# PRM_MODEL=                  # Scorer model for LLM-as-judge (leave blank to use heuristics)

# ── Security ─────────────────────────────────────────────────────
# DEPLOYMENT_MODE=hybrid      # strict-local | hybrid | cloud-assisted
# PROMPT_GUARD_LEVEL=strict   # strict | moderate | permissive
# SECURITY_ALERT_WEBHOOK=     # Webhook URL for security alerts
# SECURITY_ALERT_CHANNEL=     # Channel for security notifications
# ENCRYPTION_KEY=             # AES-256 key for secret manager (auto-generated if not set)

# ── Job Pipeline ─────────────────────────────────────────────────
# MAX_NODES_PER_JOB=20
# MAX_JOB_TIMEOUT_SEC=1800
# DEFAULT_NODE_TIMEOUT_SEC=300
# MAX_UPLOAD_SIZE_MB=100

# ── Data Lifecycle ───────────────────────────────────────────────
# RECYCLE_RETENTION_DAYS=30
# RECYCLE_MAX_SIZE_GB=10
# JOB_RETENTION_DAYS=90
# MIN_FREE_SPACE_GB=20
# VACUUM_INTERVAL_HOURS=24
