# LocalMind Environment Configuration
# Copy this file to .env and fill in your values.

# Workspace Paths (Optional defaults shown)
# WORKSPACE_DIR=C:/Users/Sam Deiter/LocalMind_Workspace
# DB_PATH=C:/Users/Sam Deiter/LocalMind_Workspace/localmind.db

# ── Local Infrastructure ─────────────────────────────────────
# The fallback is http://127.0.0.1:11434 if not set.
OLLAMA_URL=http://127.0.0.1:11434

# Optional: override default models (light, medium, heavy, ultra)
# MODEL_LIGHT=qwen2.5-coder:7b
# MODEL_MEDIUM=qwen2.5-coder:14b
# MODEL_HEAVY=qwen2.5-coder:32b
# MODEL_ULTRA=qwen2.5-coder:70b

# ── Cloud Model Routing (Optional) ──────────────────────────────
# Get a free API key at https://aistudio.google.com/apikey
# When set, LocalMind can route complex tasks to Gemini (with your approval).
# Without this key, all tasks stay fully local on Ollama.
GEMINI_API_KEY=your_api_key_here
